{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.0.4",
  "minimum_chrome_version": "111",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "debugger",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "general/popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "general_ads",
        "enabled": true,
        "path": "filters/network.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "filters/cosmetic.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "anti-adblock.js",
        "prevention.js",
        "buffering-recovery.js",
        "early.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "interruption-notice.js",
        "content.js"
      ],
      "css": [
        "interruption-notice.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "general/main-bundle.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "general/content-bundle.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "default_locale": "en"
}
