{
  "manifest_version": 3,
  "name": "YouTube Safari 재생 도구",
  "version": "1.0.0",
  "description": "YouTube 광고 스킵, PiP 및 사용 가능한 오디오 전용 스트림의 재생을 돕습니다.",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["bootstrap.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["interruption-notice.js", "mobile-skip.js"],
      "css": ["interruption-notice.css"],
      "run_at": "document_start"
    }
  ]
}
