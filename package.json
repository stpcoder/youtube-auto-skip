{
  "name": "adblock-youtube",
  "version": "3.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:filters": "node scripts/build-filters.mjs",
    "build:general": "node scripts/build-general.mjs",
    "build:safari": "node scripts/build-safari.mjs",
    "export:focus": "npm run build:general && node scripts/build-safari.mjs --integration",
    "check:package": "node scripts/check-package.mjs",
    "build:release": "node scripts/build-release.mjs",
    "verify": "npm run build:general && npm test && npm run check:package",
    "test:browser": "node scripts/test-browser.mjs",
    "test:focus": "node scripts/test-focus.mjs",
    "preview": "node scripts/preview.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "devDependencies": {
    "@adguard/dnr-converter": "2.0.0",
    "@adguard/re2-wasm": "1.2.0",
    "fflate": "0.8.3",
    "playwright": "1.64.0"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/stpcoder/youtube-auto-skip.git"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Chrome MV3 ad blocking and YouTube ad skipping with an experimental Safari port."
}
